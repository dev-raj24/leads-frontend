#!/bin/sh
# Pre-commit security hook to block obfuscated code/backdoor injections

echo "🔒 Running pre-commit security check..."

NODE_BIN=$(which node 2>/dev/null || find ~/.nvm/versions/node -type f -name node 2>/dev/null | head -n 1)

if [ -z "$NODE_BIN" ]; then
  echo "⚠️ Warning: Node binary not found for pre-commit check. Skipping."
  exit 0
fi

"$NODE_BIN" scripts/security-check.js
if [ $? -ne 0 ]; then
  echo "❌ Pre-commit hook failed: Malicious or obfuscated code detected. Commit aborted."
  exit 1
fi

